# Launcher data only; do not source this file. No ${...} placeholders or expansion.
# Local paths relative to THIS env file; reference existing backend key files.
DEMO_PUBLIC_KEY=.dev/demo/issuer-public.pem
DELEGATION_PRIVATE_KEY=.dev/demo/delegation-private.pem
DELEGATION_PUBLIC_KEY=.dev/demo/delegation-public.pem
SERVER_PORT=8080
DEMO_ISSUER=https://demo-issuer.invalid
DEMO_AUDIENCE=access-mcp
# Exact 127.0.0.1 HTTP origin with explicit port; no trailing slash.
ACCESS_BASE_URL=http://127.0.0.1:8081
