# Launcher data only; do not source this file. No ${...} placeholders or expansion.
# Copy without overwriting .env.api; match these four DB values to Compose .env.
MYSQL_DATABASE=access_demo
MYSQL_USER=access_app
MYSQL_PASSWORD=replace-with-local-app-password
DB_PORT=3307
# Local path relative to THIS env file; reference an existing delegation public key.
DEMO_PUBLIC_KEY=.dev/demo/delegation-public.pem
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=local
DEMO_ISSUER=https://demo-delegation.invalid
DEMO_AUDIENCE=access-api
