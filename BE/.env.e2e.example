# TESTER-isolated v2 management database; never point mutation scenarios at existing developer data.
# Set the project in the handoff manifest and docker compose -p mcp-access-e2e-v2.
MYSQL_DATABASE=access_e2e_v2
MYSQL_USER=access_e2e
MYSQL_PASSWORD=replace-with-isolated-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-isolated-local-root-password
DB_PORT=3308
